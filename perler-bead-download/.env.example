# 服务端口
PORT=3000

# ============================================
# 方案A：Coze 官方 API（推荐）
# ============================================
# 获取方式：在 Coze 平台部署智能体后获取 API Token
COZE_API_TOKEN=
COZE_AGENT_ID=
COZE_API_BASE=https://api.coze.cn

# ============================================
# 方案B：Stability AI
# ============================================
# 获取方式：https://stability.ai
STABILITY_API_KEY=

# ============================================
# 方案C：腾讯云混元
# ============================================
# 获取方式：腾讯云控制台
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ============================================
# 对象存储（COS）配置
# ============================================
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ============================================
# 当前使用的 AI 方案
# ============================================
# 可选值：coze | stability | tencent
AI_PROVIDER=coze
